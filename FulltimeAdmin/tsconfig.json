{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "outDir": "./javascript",
    "rootDir": "./src",
    "strict": true,
    "useUnknownInCatchVariables": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "javascript"
  ]
}